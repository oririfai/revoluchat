#!/bin/bash

# Pastikan protoc-gen-elixir ada di PATH
export PATH=$PATH:$HOME/.mix/escripts

# Buat direktori output jika belum ada
mkdir -p lib/revoluchat/grpc

# Generate code
protoc --elixir_out=plugins=grpc:./lib/revoluchat/grpc priv/protos/chat.proto
protoc --elixir_out=plugins=grpc:./lib/revoluchat/grpc priv/protos/user.proto
protoc --elixir_out=plugins=grpc:./lib/revoluchat/grpc priv/protos/admin.proto
# Move all generated .pb.ex files to the base grpc directory
find lib/revoluchat/grpc -name "*.pb.ex" -type f -exec mv {} lib/revoluchat/grpc/ \;

# Clean up empty directories
find lib/revoluchat/grpc -mindepth 1 -type d -empty -delete
find lib/revoluchat/grpc -type d -name "priv" -exec rm -rf {} +
find lib/revoluchat/grpc -type d -name "admin" -exec rm -rf {} +
find lib/revoluchat/grpc -type d -name "user" -exec rm -rf {} +
find lib/revoluchat/grpc -type d -name "revoluchat" -exec rm -rf {} +

echo "✅ Proto code generated successfully in lib/revoluchat/grpc"
